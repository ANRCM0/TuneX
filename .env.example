# RelayX replica — environment.
# Evidence for the original variable set: relayx-analysis/work/modules/001__src__config.ts:5-17
# and relayx-analysis/reports/BACKEND_REPORT.md §2.

NODE_ENV=development
PORT=3000

# Public site URL used when building payment redirect / callback URLs.
SITE_URL=http://127.0.0.1:3000

# Prisma datasource. SQLite keeps the replica self-contained.
DATABASE_URL="file:./dev.db"

# Redis. Leave empty to use the built-in in-process Redis substitute.
REDIS_URL=

# StackAuth (authentication provider of the original).
STACK_SECRET_SERVER_KEY=
STACK_PROJECT_ID=
STACK_API_URL=

# Commercial license server.
LICENSE_URL=http://127.0.0.1:3100

# Diagnostics token guarding /health/diag and /health/heap.
DIAG_TOKEN=

# Telegram notification bot.
TELEGRAM_BOT_TOKEN=

# Sentry (disabled unless DSN set).
SENTRY_DSN=

# Timezone used for all user-facing timestamps.
TZ=Asia/Shanghai
