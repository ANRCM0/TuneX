# TuneX environment.
# Copy to `.env` and fill every value marked REQUIRED. The container entrypoint
# refuses to start in production without CONFIG_SECRET.

NODE_ENV=production
PORT=3000

# Public URL users and agents reach. Must match the licensed site_url exactly for
# a self-hosted license server; it is also used in payment callbacks.
SITE_URL=https://panel.example.com

# SQLite path inside the backend container. Keep it on a volume.
DATABASE_URL=file:/data/relayx.db

# REQUIRED in production. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# The same value must be passed to every agent as --config-secret.
CONFIG_SECRET=

# Redis. A URL (redis://redis:6379) enables the BullMQ worker and the
# cross-process lock. Empty falls back to the in-process substitute.
REDIS_URL=redis://redis:6379

# StackAuth (optional; the upstream authentication provider).
STACK_SECRET_SERVER_KEY=
STACK_PROJECT_ID=
STACK_API_URL=

# License server. The compose stack runs our own on port 8899.
LICENSE_URL=http://license:8899

# Guards /health/diag and /health/heap. Empty disables both.
DIAG_TOKEN=

# Telegram notifications (optional).
TELEGRAM_BOT_TOKEN=

# Sentry (disabled unless DSN set).
SENTRY_DSN=

TZ=Asia/Shanghai

# ── seed / first start ────────────────────────────────────────────────────────
# Only read by `pnpm seed`. Without SEED_ADMIN_API_KEY a random key is generated
# and printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_API_KEY=
# Rotate the existing super admin key on the next seed run.
SEED_ADMIN_ROTATE_KEY=0

# Compose knobs.
TUNEX_IMAGE_PREFIX=ghcr.io/anrcm0
TUNEX_TAG=latest
# Domain Caddy serves when the `proxy` profile is enabled.
TUNEX_DOMAIN=panel.example.com

# ── Authentication ─────────────────────────────────────────────────────────────
# local = passwords stored as scrypt hashes + HMAC session cookies (works offline)
# stack = verify StackAuth JWTs against their JWKS (needs a StackAuth project)
AUTH_MODE=local
# Signing key for local sessions. The default is a development value: change it in production.
AUTH_SECRET=relayx-local-auth-dev-secret-change-me-0123456789
# Session lifetimes in seconds (access 1 day, refresh 30 days).
AUTH_ACCESS_TTL_SECONDS=86400
AUTH_REFRESH_TTL_SECONDS=2592000
# Email verification: `email` mails a one-time link (SMTP/Resend from /admin/settings),
# `direct` marks the signed-in account without a transport. The endpoint falls back to
# returning the link when no provider is configured.
AUTH_VERIFY_MODE=email
AUTH_VERIFY_TTL_SECONDS=86400
AUTH_VERIFY_RESEND_SECONDS=60
