# Backend origin used by the Next rewrites (/api/:path* -> BACKEND_ORIGIN/:path*).
# Upstream hard-codes the compose service name: http://relayx:3000
BACKEND_ORIGIN=http://127.0.0.1:3000

# Session lookup happens against the backend (GET /auth/me), which owns the cookie contract.
# With no StackAuth project the backend runs AUTH_MODE=local, so sign-up/sign-in work here.
# Set DEV_BYPASS_AUTH=1 only for UI work without a backend.
DEV_BYPASS_AUTH=0

# StackAuth is only needed when the backend runs AUTH_MODE=stack.
STACK_API_URL=
STACK_PROJECT_ID=
STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Local development only: makes the proxy treat every request as a verified user.
DEV_BYPASS_AUTH=0
