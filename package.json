{
  "name": "relayx",
  "private": true,
  "version": "0.0.2",
  "description": "Clean-room replica of the RelayX tunnel-management panel, built from the reverse-engineering evidence in relayx-analysis/.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "prisma generate --schema apps/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema apps/backend/prisma/schema.prisma",
    "db:reset": "prisma db push --force-reset --schema apps/backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/backend/prisma/schema.prisma",
    "db:drift": "bash scripts/db-drift.sh",
    "db:mysql:generate": "node apps/backend/scripts/gen-mysql-schema.mjs",
    "db:mysql:deploy": "prisma migrate deploy --schema apps/backend/prisma/mysql/schema.prisma",
    "seed": "pnpm --filter @relayx/backend seed",
    "dev": "pnpm --filter @relayx/backend dev",
    "start": "pnpm --filter @relayx/backend start",
    "web:dev": "pnpm --filter @relayx/web dev",
    "web:build": "pnpm --filter @relayx/web build",
    "web:start": "pnpm --filter @relayx/web start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:mysql": "RELAYX_TEST_DIALECT=mysql vitest run",
    "agent:build": "cd apps/agent && go build -o ../../dist/relayx-agent ./cmd/relayx-agent",
    "verify": "bash scripts/verify.sh",
    "e2e": "bash scripts/e2e-local.sh",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check \"apps/backend/src/**/*.ts\" \"apps/license-server/src/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \".github/workflows/*.yml\"",
    "format": "prettier --write \"apps/backend/src/**/*.ts\" \"apps/license-server/src/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \".github/workflows/*.yml\"",
    "db:mysql:smoke": "node apps/backend/scripts/mysql-smoke.mjs",
    "db:mysql:endpoints": "node apps/backend/scripts/mysql-endpoints-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "3.2.7",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
